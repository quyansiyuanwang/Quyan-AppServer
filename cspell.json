{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "dictionaryDefinitions": [
    {
      "name": "custom-words",
      "path": ".cspell/custom-words.txt"
    }
  ],
  "dictionaries": ["custom-words"],
  "ignorePaths": [
    "pnpm-lock.yaml",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "*.generated.*",
    "**/.git/**",
    "**/*.svg",
    "**/*.png",
    "**/*.jpg",
    "**/*.woff",
    "**/*.woff2",
    "**/*.eot"
  ],
  "ignoreRegExpList": [
    "/[一-鿿]+/",
    "/[぀-ゟ゠-ヿ]+/",
    "/[\\uac00-\\ud7af]+/",
    "/[0-9a-f]{8,}/",
    "/[A-Za-z0-9+/]{40,}/",
    "/\\b[A-Z]{2,5}\\b/"
  ]
}
