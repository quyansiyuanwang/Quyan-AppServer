ROOT_DOMAIN=md.qysyw.cn

# The API is intentionally outside ROOT_DOMAIN (api.qysyw.cn, not api.md.qysyw.cn).
API_ORIGIN=https://api.qysyw.cn
VITE_BACKEND_URL=https://api.qysyw.cn
VITE_AI_PROXY_URL=https://ai.qysyw.cn
VITE_RELAY_PUBLIC_BASE_URL=https://ai.qysyw.cn

# 留空时，前端会分别使用 https://ai.${ROOT_DOMAIN} 与 https://docs.${ROOT_DOMAIN}。
VITE_RELAY_PUBLIC_BASE_URL=
VITE_APP_DOCS_BASE_URL=
VITE_ENABLE_OBFUSCATION=false
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_FRONTEND_MODE=multi
# 留空时，前端会使用 https://legacy.${ROOT_DOMAIN}。
VITE_LEGACY_APP_ORIGIN=

VITE_APRIL_FOOL_ENABLED=true
VITE_RECAPTCHA_SITE_KEY=6LceqmwsAAAAADQKTeFdlTSfhiZzqeFm1d_ensal

# Cloudflare Turnstile Site Key (获取地址: https://dash.cloudflare.com/turnstile)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADvMs3XCZibvSjIK
