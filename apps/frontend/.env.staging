ROOT_DOMAIN=qysyw.cn
VITE_PUBLIC_SITE_HOST=staging.qysyw.cn

# Browser API calls stay same-origin in staging as well. The edge proxy owns
# the backend origin so no api.* endpoint is published to the browser bundle.
VITE_BACKEND_URL=
VITE_AI_PROXY_URL=/relay/proxy
VITE_RELAY_PUBLIC_BASE_URL=/relay/proxy
VITE_APP_DOCS_BASE_URL=https://docs.qysyw.cn
VITE_ENABLE_OBFUSCATION=false
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_FRONTEND_MODE=multi
VITE_APRIL_FOOL_ENABLED=false
