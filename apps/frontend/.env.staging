PLATFORM_ROOT_DOMAIN=qysyw.cn
SITE_ROOT_DOMAIN=staging.qysyw.cn
VITE_PUBLIC_SITE_HOST=staging.qysyw.cn

# Staging intentionally uses the production API and database. Never let these
# requests fall back to the current SPA or authentication hostname.
VITE_BACKEND_URL=https://api.qysyw.cn
# The public AI gateway forwards Relay traffic to the production API relay path.
VITE_AI_PROXY_URL=https://ai.qysyw.cn
VITE_RELAY_PUBLIC_BASE_URL=https://ai.qysyw.cn
VITE_APP_DOCS_BASE_URL=https://docs.qysyw.cn
VITE_ENABLE_OBFUSCATION=false
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_FRONTEND_MODE=multi
VITE_APRIL_FOOL_ENABLED=false
