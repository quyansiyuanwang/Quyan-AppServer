PLATFORM_ROOT_DOMAIN=qysyw.cn
SITE_ROOT_DOMAIN=qysyw.cn
LOCAL_ROOT_DOMAIN=qysyw.test
# Shared preference cookies use the deployment site's root domain. All sites
# under this domain (for example www/auth/ai.qysyw.cn) share theme and locale.
VITE_PUBLIC_SITE_HOST=www.qysyw.cn
# Keep this blank for local Vite development. Release profiles must set the
# public API origin (for example, https://api.qysyw.cn), never an SPA host.
VITE_BACKEND_URL=
VITE_AI_PROXY_URL=/relay/proxy
# 留空时，前端会分别使用 https://ai.${PLATFORM_ROOT_DOMAIN} 与 https://docs.${PLATFORM_ROOT_DOMAIN}。
VITE_RELAY_PUBLIC_BASE_URL=
VITE_APP_DOCS_BASE_URL=
VITE_ENABLE_OBFUSCATION=false
VITE_ENABLE_VUE_DEVTOOLS=false
# Generate .gz/.br files only when the static host is configured to serve
# pre-compressed assets (gzip_static and/or brotli_static). The default keeps
# release builds fast and lets the host or CDN compress dynamically.
VITE_PRECOMPRESS_ASSETS=false
# Generate stats.html only for an explicit bundle-size investigation.
VITE_BUILD_ANALYZE=false
VITE_FRONTEND_MODE=multi
# Optional local qysyw.test HTTPS certificate paths. local:setup generates the default paths automatically.
VITE_HTTPS_KEY_PATH=
VITE_HTTPS_CERT_PATH=

VITE_APRIL_FOOL_ENABLED=false
# Google reCAPTCHA v3 Site Key (获取地址: https://www.google.com/recaptcha/admin)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# Cloudflare Turnstile Site Key (获取地址: https://dash.cloudflare.com/turnstile)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
