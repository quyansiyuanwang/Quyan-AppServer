ROOT_DOMAIN=qysyw.cn
LOCAL_ROOT_DOMAIN=qysyw.test

VITE_BACKEND_URL=/api
VITE_AI_PROXY_URL=/api/relay/proxy
# 留空时，前端会分别使用 https://ai.${ROOT_DOMAIN} 与 https://docs.${ROOT_DOMAIN}。
VITE_RELAY_PUBLIC_BASE_URL=
VITE_APP_DOCS_BASE_URL=
VITE_ENABLE_OBFUSCATION=false
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_FRONTEND_MODE=multi
# 留空时，前端会使用 https://legacy.${ROOT_DOMAIN}。
VITE_LEGACY_APP_ORIGIN=

# Optional local qysyw.test HTTPS certificate paths. local:setup generates the default paths automatically.
VITE_HTTPS_KEY_PATH=
VITE_HTTPS_CERT_PATH=

VITE_APRIL_FOOL_ENABLED=false
# Google reCAPTCHA v3 Site Key (获取地址: https://www.google.com/recaptcha/admin)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# Cloudflare Turnstile Site Key (获取地址: https://dash.cloudflare.com/turnstile)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
