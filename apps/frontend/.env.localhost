PLATFORM_ROOT_DOMAIN=qysyw.cn
SITE_ROOT_DOMAIN=qysyw.cn
LOCAL_ROOT_DOMAIN=qysyw.test

# 免特权本地开发模式（pnpm run dev）：单一站点、纯 HTTP localhost。
# 不需要 hosts 改动、mkcert 或管理员权限。多域名 HTTPS 请使用默认的
# development 模式（pnpm run dev:domains）。
VITE_DEV_SINGLE_SITE=true
# 可替换为任意已注册站点（或用其主机前缀）：management / account / public / terminal / chat 等。
VITE_DEV_SITE_PROFILE=management-core
# 证书存在时也必须保持 HTTP，否则 localhost 会命中 *.qysyw.test 的证书。
VITE_HTTPS_ENABLED=false

VITE_BACKEND_URL=
VITE_AI_PROXY_URL=/relay/proxy
VITE_RELAY_PUBLIC_BASE_URL=/relay/proxy
VITE_APP_DOCS_BASE_URL=http://localhost:4173
VITE_ENABLE_OBFUSCATION=false
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_FRONTEND_MODE=multi
# Google reCAPTCHA v3 Site Key（后端默认 RECAPTCHA_ENABLED=false，此处仅保持与 development 一致）
VITE_RECAPTCHA_SITE_KEY=6LceqmwsAAAAADQKTeFdlTSfhiZzqeFm1d_ensal
# Cloudflare Turnstile Site Key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADVWzt8g9uiwjM3g
VITE_APRIL_FOOL_ENABLED=true
