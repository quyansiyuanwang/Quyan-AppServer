{
  "name": "@appserver/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "--- a_dev ---------------------------": "",
    "dev": "vite",
    "production": "vite --mode production",
    "preview": "vite preview",
    "--- b_build_atomic ----------------": "",
    "compile": "vite build",
    "compile:production": "vite build --mode production",
    "compile:staging": "vite build --mode staging",
    "--- c_build_meta ------------------": "",
    "build:only": "pnpm run compile",
    "build:only:production": "pnpm run compile:production",
    "build:only:staging": "pnpm run compile:staging",
    "build": "pnpm run type:generate && concurrently --kill-others-on-fail --names types,compile \"pnpm run type-check\" \"pnpm run build:only\"",
    "build:production": "pnpm run type:generate && concurrently --kill-others-on-fail --names types,compile \"pnpm run type-check\" \"pnpm run build:only:production\"",
    "build:staging": "pnpm run type:generate && concurrently --kill-others-on-fail --names types,compile \"pnpm run type-check\" \"pnpm run build:only:staging\"",
    "build:full": "pnpm run openapi:generate && pnpm run build",
    "build:full:production": "pnpm run openapi:generate && pnpm run build:production",
    "--- d_typecheck -------------------": "",
    "type-check": "vue-tsc --build",
    "type:generate": "node scripts/generate-route-types.js",
    "--- e_openapi ---------------------": "",
    "openapi:generate": "openapi-ts && pnpm run client:generate",
    "openapi:sync-generate": "pnpm run openapi:generate",
    "client:generate": "node scripts/generate-api-constants.js && node scripts/generate-api-types-map.js && node scripts/generate-replay-protected-endpoints.js",
    "--- f_lint_format -----------------": "",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint-format-check": "pnpm run lint:check && pnpm run format:check && pnpm run type-check",
    "spell:check": "cspell lint \"src/**/*.{ts,js,vue}\" \"scripts/**/*.js\"",
    "--- g_test ------------------------": "",
    "test": "vitest run",
    "test:node": "vitest run --dir tests/node",
    "test:dom": "vitest run --dir tests/dom",
    "test:watch:node": "vitest --dir tests/node",
    "test:watch:dom": "vitest --dir tests/dom",
    "test:ci": "pnpm run test",
    "test:coverage": "vitest run --coverage",
    "test:taxonomy": "node ./tests/scripts/validate-test-taxonomy.mjs",
    "--- h_check -----------------------": "",
    "check": "pnpm run lint-format-check && pnpm run test:taxonomy && pnpm run test",
    "precommit": "pnpm run check"
  },
  "dependencies": {
    "@appserver/shared": "workspace:*",
    "@element-plus/icons-vue": "^2.3.1",
    "@simplewebauthn/browser": "^13.2.2",
    "@tanstack/vue-query": "^5.92.9",
    "@types/dompurify": "^3.0.5",
    "@types/sortablejs": "^1.15.9",
    "@vueuse/core": "^11.0.0",
    "@vueuse/shared": "^11.0.0",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.3.3",
    "echarts": "^5.6.0",
    "element-plus": "2.13.6",
    "github-markdown-css": "^5.9.0",
    "heatmap.js": "^2.0.5",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "nvm": "^0.0.4",
    "pinia": "^3.0.3",
    "sass": "^1.95.1",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@hey-api/openapi-ts": "^0.88.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "javascript-obfuscator": "^5.3.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "prettier": "3.6.2",
    "rollup-plugin-obfuscator": "^1.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.2.2",
    "terser": "^5.44.1",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^30.0.0",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.1.3",
    "vue-tsc": "3.2.6"
  }
}
