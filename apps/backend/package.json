{
  "name": "@appserver/backend",
  "version": "1.0.23",
  "description": "",
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "--- a_dev ---------------------------": "",
    "dev": "nodemon --watch src --watch prisma/schema.prisma --ext ts,prisma --ignore src/build --delay 500ms --exec \"pnpm run openapi:generate && bun ./src/main.ts\"",
    "tsx": "bun ./src/main.ts",
    "--- b_build_atomic ----------------": "",
    "clean": "rimraf ./dist",
    "compile": "bun esbuild.config.mjs",
    "copy:static": "copyfiles -u 1 \"src/**/*.{json,html,css}\" dist/",
    "build:info:stub": "node ./scripts/ensure-build-info.mjs",
    "build:info:inject": "bun scripts/inject-build-info.mjs",
    "--- c_build_meta ------------------": "",
    "build:only": "pnpm run clean && pnpm run build:info:inject && pnpm run compile && pnpm run copy:static",
    "build:only:tsc": "pnpm run clean && pnpm run type-check && pnpm run tsc && pnpm run copy:static",
    "build": "pnpm run type-check && pnpm run build:only",
    "build:prod": "cross-env NODE_ENV=production pnpm run build:only",
    "build:full": "pnpm run openapi:generate && pnpm run build",
    "build:full:prod": "pnpm run openapi:generate && pnpm run build:prod",
    "--- d_typecheck -------------------": "",
    "type-check": "tsc --noEmit --skipLibCheck",
    "tsc": "tsc && tsc-alias",
    "--- e_openapi ---------------------": "",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "tsoa:spec-and-routes": "tsoa spec-and-routes && bun scripts/add-replay-protection-markers.js && bun scripts/generate-route-paths.ts",
    "openapi:generate": "pnpm run tsoa:spec-and-routes",
    "--- f_db --------------------------": "",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --skip-generate",
    "db:push:prod:adl": "prisma db push --skip-generate --accept-data-loss",
    "db:pull": "prisma db pull",
    "db:push:reset": "prisma db push --force-reset",
    "db:push:adl": "prisma db push --accept-data-loss",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --name",
    "db:migrate:resolve:baseline": "prisma migrate resolve --applied 20260706000000_baseline",
    "db:seed": "bun ./prisma/seed.ts",
    "db:seed:prod": "bun ./prisma/seed.prod.ts",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:reset-seed": "prisma migrate reset && pnpm run db:seed",
    "--- g_lint_format -----------------": "",
    "lint": "eslint \"**/*.{ts,js,tsx,jsx}\" --fix --cache",
    "lint:check": "eslint src/ --ext .js,.jsx,.ts,.tsx,.cjs,.mjs",
    "format": "prettier --write \"**/*.{ts,js,tsx,jsx,json,css,md}\"",
    "format:check": "prettier --check src/",
    "lint-format-check": "pnpm run lint:check && pnpm run format:check && pnpm run type-check",
    "arch:prisma-boundary": "eslint \"src/**/*.ts\" --max-warnings 0",
    "spell:check": "cspell lint \"src/**/*.{ts,js,mjs}\" \"tests/**/*.ts\"",
    "--- h_test ------------------------": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:api": "pnpm run test:integration && pnpm run test:contract",
    "test:ci": "pnpm run openapi:generate && pnpm run db:generate && pnpm run type-check && pnpm run test:unit && pnpm run test:api",
    "--- i_check -----------------------": "",
    "check:explicit-deps": "bun scripts/check-explicit-deps.mjs",
    "check": "pnpm run lint-format-check && pnpm run test:unit && pnpm run test:api && pnpm run check:explicit-deps",
    "precommit": "pnpm run openapi:generate && pnpm run check",
    "--- j_start -----------------------": "",
    "start": "bun ./dist/index.cjs",
    "start:prod": "cross-env NODE_ENV=production bun ./dist/index.cjs",
    "start:watch": "nodemon --watch dist --ext cjs --exec \"bun ./dist/index.cjs\" --delay 2s",
    "start:watch:prod": "cross-env NODE_ENV=production nodemon --watch dist --ext cjs --exec \"bun ./dist/index.cjs\" --delay 2s",
    "--- k_pm2 -------------------------": "",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:start:watch": "pm2 start ecosystem.config.cjs --watch",
    "pm2:start:watch:prod": "pm2 start ecosystem.config.cjs --env production --watch",
    "pm2:stop": "pm2 stop backend",
    "pm2:restart": "pm2 restart backend",
    "pm2:delete": "pm2 delete backend",
    "pm2:logs": "pm2 logs backend",
    "pm2:status": "pm2 status",
    "pm2:rebuild": "pm2 delete backend && pnpm run build:prod && pnpm run pm2:start:prod",
    "--- l_deploy ----------------------": "",
    "deploy:preflight": "node ./scripts/bun-deployment-preflight.mjs",
    "deploy:linux:prod": "bash ./scripts/deploy-bun-pm2.sh",
    "--- m_scripts ---------------------": "",
    "relay-token:backfill-used-quota": "bun ./scripts/backfill-relay-token-used-quota.ts",
    "relay-token:backfill-used-quota:apply": "bun ./scripts/backfill-relay-token-used-quota.ts --apply",
    "json-endpoint:backfill-root-slugs": "bun ./scripts/backfill-json-endpoint-root-slugs.ts",
    "json-endpoint:backfill-root-slugs:apply": "bun ./scripts/backfill-json-endpoint-root-slugs.ts --apply",
    "relay-history:diagnose-display-snapshots": "bun ./scripts/diagnose-relay-display-channel-snapshots.ts",
    "trusted-device:cleanup-legacy": "bun ./scripts/cleanup-legacy-trusted-device-keys.ts",
    "balance:cleanup-consumption-older-than-month": "bun ./scripts/cleanup-old-consumption-records.ts",
    "balance:cleanup-consumption-older-than-month:apply": "bun ./scripts/cleanup-old-consumption-records.ts --apply",
    "generate-operation-ids": "bun ./scripts/generate-operation-ids.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@appserver/shared": "workspace:*",
    "@simplewebauthn/server": "^13.2.3",
    "@types/ioredis": "^4.28.10",
    "@types/node-cron": "^3.0.11",
    "app-root-path": "^3.1.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "decimal.js": "^10.6.0",
    "depcheck": "^1.4.7",
    "dotenv": "^17.4.1",
    "express": "^5.1.0",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^8.0.1",
    "fs-extra": "^11.2.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lru-cache": "^11.2.5",
    "lz-string": "^1.5.0",
    "md5": "^2.3.0",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "openai": "^4.65.0",
    "picomatch": "^4.0.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@eslint/js": "^9.39.4",
    "@hey-api/openapi-ts": "^0.91.1",
    "@prisma/client": "^6.19.2",
    "@rushstack/eslint-patch": "^1.8.0",
    "@swc/core": "^1.15.3",
    "@tsoa/runtime": "^7.0.0-alpha.0",
    "@types/adm-zip": "^0.5.7",
    "@types/ali-oss": "^6.16.11",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/jszip": "^3.4.1",
    "@types/md5": "^2.3.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.0.15",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.3.0",
    "nodemon": "^3.1.7",
    "openapi-typescript": "^7.10.1",
    "pm2": "^6.0.14",
    "prettier": "^3.3.3",
    "prisma": "^6.19.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-morph": "^27.0.2",
    "tslib": "^2.7.0",
    "tsoa": "^7.0.0-alpha.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.15",
    "vitest-mock-extended": "^3.1.0"
  }
}
