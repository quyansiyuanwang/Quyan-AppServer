generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String   @id @default(cuid())
  status                   Int      @default(1)
  createTime               DateTime @default(now())
  updateTime               DateTime @updatedAt
  username                 String   @unique
  name                     String?
  password                 String
  email                    String?
  twoFactorEnabled         Boolean  @default(false)
  twoFactorPasskeyRequired Boolean  @default(false)
  groupId                  String?
  permissionAdds           Json
  permissionRemoves        Json
  accountOwnerId           String?
  parentUserId             String?
  userType                 String   @default("root") @db.VarChar(20)
  ramUsername              String?
  displayName              String?
  forcePasswordChange      Boolean  @default(false)

  group                        Group?                          @relation(fields: [groupId], references: [id])
  accountOwner                 User?                           @relation("RamAccountUsers", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  accountUsers                 User[]                          @relation("RamAccountUsers")
  ownedRamGroups               Group[]                         @relation("RamGroupOwner")
  parentUser                   User?                           @relation("RamUserChildren", fields: [parentUserId], references: [id], onDelete: SetNull)
  childUsers                   User[]                          @relation("RamUserChildren")
  ownedRamRoles                RamRole[]                       @relation("RamRoleOwner")
  ramRoleBindings              RamUserRoleBinding[]
  assumedRoleSessions          RamRoleSession[]                @relation("RamRoleSessionSubject")
  relayTokens                  RelayToken[]
  accessKeys                   AccessKey[]
  oauthClients                 OAuthClient[]
  authCenterClients            AuthCenterClient[]
  oauthAuthorizationCodes      OAuthAuthorizationCode[]
  authCenterAuthorizationCodes AuthCenterAuthorizationCode[]
  oauthAccessTokens            OAuthAccessToken[]
  authCenterAccessTokens       AuthCenterAccessToken[]
  oauthRefreshTokens           OAuthRefreshToken[]
  authCenterRefreshTokens      AuthCenterRefreshToken[]
  oauthConsents                OAuthConsent[]
  authCenterConsents           AuthCenterConsent[]
  balanceAccount               BalanceAccount?
  monthlyPasses                UserMonthlyPass[]
  remoteTerminalEntitlements   RemoteTerminalUserEntitlement[]
  remoteTerminalDevices        RemoteTerminalDeviceBinding[]
  passkeys                     PasskeyCredential[]
  externalIdentities           UserExternalIdentity[]
  twoFactorCredential          TwoFactorCredential?
  jsonEndpoints                JsonEndpoint[]
  articles                     Article[]
  onlineSessions               UserOnlineSession[]
  legalPoliciesCreated         LegalPolicyVersion[]            @relation("LegalPolicyCreatedBy")
  legalPoliciesUpdated         LegalPolicyVersion[]            @relation("LegalPolicyUpdatedBy")
  policyAcceptances            UserPolicyAcceptance[]
  tickets                      Ticket[]
  ticketComments               TicketComment[]
  ticketAssignments            Ticket[]                        @relation("TicketAssignee")
  userScripts                  UserScript[]
  scriptExecutions             UserScriptExecution[]
  redemptionCodesUsed          RedemptionCode[]                @relation("RedemptionCodeUsedBy")
  redemptionCodesCreated       RedemptionCode[]                @relation("RedemptionCodeCreatedBy")
  conversations                Conversation[]
  notificationPreference       NotificationPreference?
  notificationInboxItems       NotificationInboxItem[]
  oauthClientsReviewed         OAuthClient[]                   @relation("OAuthClientReviewedBy")
  authCenterClientsReviewed    AuthCenterClient[]              @relation("AuthCenterClientReviewedBy")
  ownedRamPolicies             RamPolicy[]                     @relation("RamPolicyOwner")
  ramPolicyAttachmentOwners    RamPolicyAttachment[]           @relation("RamPolicyAttachmentOwner")
  developerProjects            DeveloperProject[]

  @@unique([accountOwnerId, ramUsername])
  @@index([username])
  @@index([groupId])
  @@index([accountOwnerId])
  @@index([parentUserId])
  @@index([accountOwnerId, userType])
  @@map("users")
}

model DeveloperProject {
  id             String                   @id @default(cuid())
  status         Int                      @default(1)
  createTime     DateTime                 @default(now())
  updateTime     DateTime                 @updatedAt
  userId         String
  name           String                   @db.VarChar(100)
  slug           String                   @unique @db.VarChar(80)
  description    String?                  @db.VarChar(500)
  dailyFreeQuota Int                      @default(1000)
  overageEnabled Boolean                  @default(false)
  statusPagePublished Boolean              @default(false)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys        DeveloperProjectApiKey[]
  kvEntries      DeveloperKvEntry[]
  shortLinks     DeveloperShortLink[]
  secrets        DeveloperSecret[]
  verifications  DeveloperVerification[]
  pushChannels   DeveloperPushChannel[]
  pushDeliveries DeveloperPushDelivery[]
  pushRequests   DeveloperPushRequest[]
  statusMonitors DeveloperStatusMonitor[]
  quotaUsages    DeveloperQuotaUsage[]

  @@unique([userId, name])
  @@index([userId, status])
  @@map("developer_projects")
}

model DeveloperProjectApiKey {
  id           String           @id @default(cuid())
  status       Int              @default(1)
  createTime   DateTime         @default(now())
  updateTime   DateTime         @updatedAt
  projectId    String
  name         String           @db.VarChar(100)
  keyHash      String           @unique @db.Char(64)
  keyPrefix    String           @db.VarChar(20)
  scopes       Json
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  requestCount Int              @default(0)
  project      DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("developer_project_api_keys")
}

model DeveloperKvEntry {
  id         String           @id @default(cuid())
  status     Int              @default(1)
  createTime DateTime         @default(now())
  updateTime DateTime         @updatedAt
  projectId  String
  key        String           @db.VarChar(191)
  value      Json
  version    Int              @default(1)
  expiresAt  DateTime?
  project    DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId, expiresAt])
  @@map("developer_kv_entries")
}

model DeveloperShortLink {
  id         String           @id @default(cuid())
  status     Int              @default(1)
  createTime DateTime         @default(now())
  updateTime DateTime         @updatedAt
  projectId  String
  code       String           @unique @db.VarChar(80)
  targetUrl  String           @db.Text
  enabled    Boolean          @default(true)
  expiresAt  DateTime?
  clickCount Int              @default(0)
  project    DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clicks     DeveloperShortLinkClick[]

  @@index([projectId, createTime])
  @@map("developer_short_links")
}

model DeveloperShortLinkClick {
  id          String             @id @default(cuid())
  status      Int                @default(1)
  createTime  DateTime           @default(now())
  updateTime  DateTime           @updatedAt
  shortLinkId String
  clickedAt   DateTime           @default(now())
  sourceHost  String?            @db.VarChar(255)
  userAgent   String?            @db.VarChar(255)
  country     String?            @db.VarChar(8)
  shortLink   DeveloperShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([shortLinkId, clickedAt])
  @@index([country, clickedAt])
  @@map("developer_short_link_clicks")
}

model DeveloperSecret {
  id         String           @id @default(cuid())
  status     Int              @default(1)
  createTime DateTime         @default(now())
  updateTime DateTime         @updatedAt
  projectId  String
  alias      String           @db.VarChar(100)
  ciphertext String           @db.Text
  iv         String           @db.VarChar(64)
  authTag    String           @db.VarChar(64)
  keyVersion Int              @default(1)
  lastUsedAt DateTime?
  project    DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, alias])
  @@map("developer_secrets")
}

model DeveloperVerification {
  id             String           @id @default(cuid())
  status         Int              @default(1)
  createTime     DateTime         @default(now())
  updateTime     DateTime         @updatedAt
  projectId      String
  channel        String           @db.VarChar(20)
  recipient      String           @db.VarChar(320)
  purpose        String           @db.VarChar(100)
  sourceIpHash   String?          @db.Char(64)
  codeHash       String           @db.Char(64)
  expiresAt      DateTime
  remainingTries Int              @default(5)
  consumedAt     DateTime?
  project        DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recipient, purpose, expiresAt])
  @@index([projectId, sourceIpHash, createTime])
  @@map("developer_verifications")
}

model DeveloperPushChannel {
  id          String                  @id @default(cuid())
  status      Int                     @default(1)
  createTime  DateTime                @default(now())
  updateTime  DateTime                @updatedAt
  projectId   String
  name        String                  @db.VarChar(100)
  type        String                  @db.VarChar(30)
  endpoint    String?                 @db.Text
  secretAlias String?                 @db.VarChar(100)
  config      Json?
  enabled     Boolean                 @default(true)
  project     DeveloperProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries  DeveloperPushDelivery[]

  @@unique([projectId, name])
  @@index([projectId, enabled])
  @@map("developer_push_channels")
}

model DeveloperPushDelivery {
  id             String               @id @default(cuid())
  status         Int                  @default(1)
  createTime     DateTime             @default(now())
  updateTime     DateTime             @updatedAt
  projectId      String
  channelId      String
  title          String               @db.VarChar(200)
  content        String               @db.Text
  idempotencyKey String?              @db.VarChar(100)
  deliveryStatus String               @db.VarChar(20)
  attemptCount   Int                  @default(0)
  nextRetryAt    DateTime?
  errorMessage   String?              @db.VarChar(500)
  project        DeveloperProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel        DeveloperPushChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([projectId, createTime])
  @@index([projectId, idempotencyKey])
  @@index([deliveryStatus, nextRetryAt])
  @@map("developer_push_deliveries")
}

model DeveloperPushRequest {
  id             String           @id @default(cuid())
  status         Int              @default(1)
  createTime     DateTime         @default(now())
  updateTime     DateTime         @updatedAt
  projectId      String
  idempotencyKey String           @db.VarChar(100)
  requestStatus  String           @default("pending") @db.VarChar(20)
  project        DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createTime])
  @@map("developer_push_requests")
}

model DeveloperStatusMonitor {
  id            String           @id @default(cuid())
  status        Int              @default(1)
  createTime    DateTime         @default(now())
  updateTime    DateTime         @updatedAt
  projectId     String
  name          String           @db.VarChar(100)
  targetUrl     String           @db.Text
  method        String           @default("GET") @db.VarChar(10)
  successStatusCodes Json?
  intervalSec   Int              @default(60)
  enabled       Boolean          @default(true)
  lastCheckedAt DateTime?
  lastStatus    String?          @db.VarChar(20)
  project       DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks        DeveloperStatusCheck[]

  @@index([projectId, enabled])
  @@map("developer_status_monitors")
}

model DeveloperStatusCheck {
  id           String                 @id @default(cuid())
  status       Int                    @default(1)
  createTime   DateTime               @default(now())
  updateTime   DateTime               @updatedAt
  monitorId    String
  checkedAt    DateTime               @default(now())
  checkStatus  String                 @db.VarChar(20)
  statusCode   Int?
  latencyMs    Int
  errorMessage String?                @db.VarChar(500)
  monitor      DeveloperStatusMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("developer_status_checks")
}

model DeveloperQuotaUsage {
  id           String           @id @default(cuid())
  status       Int              @default(1)
  createTime   DateTime         @default(now())
  updateTime   DateTime         @updatedAt
  projectId    String
  service      String           @db.VarChar(30)
  usageDate    DateTime         @db.Date
  requestCount Int              @default(0)
  project      DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, service, usageDate])
  @@map("developer_quota_usages")
}

model DeveloperQuotaOverride {
  id             String   @id @default(cuid())
  status         Int      @default(1)
  createTime     DateTime @default(now())
  updateTime     DateTime @updatedAt
  subjectType    String   @db.VarChar(10)
  subjectId      String   @db.VarChar(191)
  service        String   @default("*") @db.VarChar(30)
  dailyFreeQuota Int
  expiresAt      DateTime?
  createdByUserId String  @db.VarChar(191)

  @@unique([subjectType, subjectId, service])
  @@index([subjectType, subjectId, status, expiresAt])
  @@map("developer_quota_overrides")
}

model UserExternalIdentity {
  id               String    @id @default(cuid())
  status           Int       @default(1)
  createTime       DateTime  @default(now())
  updateTime       DateTime  @updatedAt
  userId           String
  provider         String    @db.VarChar(50)
  providerUserId   String    @db.VarChar(191)
  providerUnionId  String?   @db.VarChar(191)
  providerUsername String?   @db.VarChar(191)
  providerEmail    String?   @db.VarChar(191)
  avatarUrl        String?   @db.VarChar(500)
  profileRaw       Json?
  accessToken      String?   @db.Text
  refreshToken     String?   @db.Text
  scope            String?   @db.VarChar(500)
  linkedAt         DateTime  @default(now())
  lastLoginAt      DateTime?
  lastSyncedAt     DateTime?
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([provider, providerUnionId])
  @@index([userId])
  @@index([provider])
  @@index([provider, status])
  @@map("user_external_identities")
}

model Group {
  id             String   @id @default(cuid())
  status         Int      @default(1)
  createTime     DateTime @default(now())
  updateTime     DateTime @updatedAt
  username       String   @unique
  name           String?
  permissions    Json
  level          Int      @default(1)
  description    String?
  accountOwnerId String?

  users           User[]
  accountOwner    User?                 @relation("RamGroupOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  ramRoleBindings RamGroupRoleBinding[]

  @@index([accountOwnerId])
  @@map("groups")
}

model RamRole {
  id                 String   @id @default(cuid())
  status             Int      @default(1)
  createTime         DateTime @default(now())
  updateTime         DateTime @updatedAt
  accountOwnerId     String
  name               String
  description        String?  @db.Text
  trustPolicy        Json?
  maxSessionDuration Int      @default(3600)

  accountOwner  User                  @relation("RamRoleOwner", fields: [accountOwnerId], references: [id], onDelete: Cascade)
  userBindings  RamUserRoleBinding[]
  groupBindings RamGroupRoleBinding[]
  sessions      RamRoleSession[]

  @@unique([accountOwnerId, name])
  @@index([accountOwnerId])
  @@index([status])
  @@map("ram_roles")
}

model RamUserRoleBinding {
  id             String   @id @default(cuid())
  status         Int      @default(1)
  createTime     DateTime @default(now())
  updateTime     DateTime @updatedAt
  accountOwnerId String
  userId         String
  roleId         String

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([accountOwnerId, userId, roleId])
  @@index([accountOwnerId])
  @@index([userId])
  @@index([roleId])
  @@map("ram_user_role_bindings")
}

model RamGroupRoleBinding {
  id             String   @id @default(cuid())
  status         Int      @default(1)
  createTime     DateTime @default(now())
  updateTime     DateTime @updatedAt
  accountOwnerId String
  groupId        String
  roleId         String

  group Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role  RamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([accountOwnerId, groupId, roleId])
  @@index([accountOwnerId])
  @@index([groupId])
  @@index([roleId])
  @@map("ram_group_role_bindings")
}

model RamRoleSession {
  id             String    @id @default(cuid())
  status         Int       @default(1)
  createTime     DateTime  @default(now())
  updateTime     DateTime  @updatedAt
  accountOwnerId String
  roleId         String
  subjectUserId  String
  sessionName    String
  tokenJtiHash   String?   @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?   @db.Text

  role        RamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  subjectUser User    @relation("RamRoleSessionSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([accountOwnerId])
  @@index([roleId])
  @@index([subjectUserId])
  @@index([status, expiresAt])
  @@map("ram_role_sessions")
}

model RamPolicy {
  id             String   @id @default(cuid())
  status         Int      @default(1)
  createTime     DateTime @default(now())
  updateTime     DateTime @updatedAt
  accountOwnerId String
  name           String   @db.VarChar(128)
  activeName     String?  @db.VarChar(128)
  description    String?  @db.Text
  permissions    Json
  type           String   @default("custom") @db.VarChar(20)

  accountOwner      User                  @relation("RamPolicyOwner", fields: [accountOwnerId], references: [id], onDelete: Cascade)
  policyAttachments RamPolicyAttachment[]

  @@unique([accountOwnerId, activeName])
  @@index([accountOwnerId])
  @@map("ram_policies")
}

model RamPolicyAttachment {
  id             String   @id @default(cuid())
  status         Int      @default(1)
  createTime     DateTime @default(now())
  updateTime     DateTime @updatedAt
  accountOwnerId String
  policyId       String
  targetType     String   @db.VarChar(20)
  targetId       String

  accountOwner User      @relation("RamPolicyAttachmentOwner", fields: [accountOwnerId], references: [id], onDelete: Cascade)
  policy       RamPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([accountOwnerId, policyId, targetType, targetId])
  @@index([accountOwnerId])
  @@index([policyId])
  @@index([targetType, targetId])
  @@map("ram_policy_attachments")
}

model APILog {
  id              String   @id @default(cuid())
  status          Int      @default(1)
  createTime      DateTime @default(now())
  updateTime      DateTime @updatedAt
  requestID       String   @unique
  userID          String?
  path            String
  method          String
  requestHeaders  Json?
  queryParams     Json?
  bodyParams      Json?
  ipAddress       String
  response        Json?
  responseHeaders Json?
  statusCode      Int

  @@index([userID])
  @@index([path])
  @@index([createTime])
  @@index([status, createTime])
  @@map("api_logs")
}

model BusinessLog {
  id                 String   @id @default(cuid())
  status             Int      @default(1)
  createTime         DateTime @default(now())
  updateTime         DateTime @updatedAt
  operationType      String
  operationCategory  String
  actorUserId        String?
  targetUserId       String?
  targetResourceId   String?
  targetResourceType String?
  description        String   @db.Text
  changes            Json?
  metadata           Json?
  success            Boolean  @default(true)
  errorMessage       String?  @db.Text
  requestId          String?
  ipAddress          String
  userAgent          String?  @db.Text

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([operationType])
  @@index([operationCategory])
  @@index([createTime])
  @@index([requestId])
  @@map("business_logs")
}

model UserOnlineSession {
  id              String    @id @default(cuid())
  status          Int       @default(1)
  createTime      DateTime  @default(now())
  updateTime      DateTime  @updatedAt
  userId          String
  authSessionId   String
  startedAt       DateTime  @default(now())
  lastHeartbeatAt DateTime
  endedAt         DateTime?
  durationSeconds Int?
  lastIpAddress   String
  lastLocation    String?
  userAgent       String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([authSessionId])
  @@index([startedAt])
  @@index([lastHeartbeatAt])
  @@index([status])
  @@index([userId, authSessionId, status])
  @@index([userId, startedAt])
  @@map("user_online_sessions")
}

model ServerConfig {
  id         String   @id @default(cuid())
  status     Int      @default(1)
  createTime DateTime @default(now())
  updateTime DateTime @updatedAt
  key        String   @unique
  value      String   @db.Text

  @@index([key])
  @@map("server_configs")
}

model EmailVerification {
  id         String   @id @default(cuid())
  status     Int      @default(1)
  createTime DateTime @default(now())
  updateTime DateTime @updatedAt
  email      String
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)

  @@index([email, code])
  @@index([expiresAt])
  @@map("email_verifications")
}

model EmailRateLimitLog {
  id          String   @id @default(cuid())
  status      Int      @default(1)
  createTime  DateTime @default(now())
  updateTime  DateTime @updatedAt
  ipAddress   String
  email       String
  action      String   @default("verification_code")
  requestTime DateTime

  @@index([ipAddress, action, requestTime])
  @@index([email, action, requestTime])
  @@index([ipAddress, email, action, requestTime])
  @@index([requestTime])
  @@map("email_rate_limit_logs")
}

model IPBlackList {
  id            String    @id @default(cuid())
  status        Int       @default(1)
  createTime    DateTime  @default(now())
  updateTime    DateTime  @updatedAt
  ipAddress     String    @unique
  ExpireTime    DateTime?
  triedAccounts Int       @default(0)
  reason        String?   @db.Text
  bannedBy      String?
  banType       String    @default("auto")
  banLevel      Int       @default(0)

  @@index([ipAddress])
  @@index([status, ExpireTime])
  @@map("ip_black_lists")
}

model IPWhiteList {
  id         String    @id @default(cuid())
  status     Int       @default(1)
  createTime DateTime  @default(now())
  updateTime DateTime  @updatedAt
  ipAddress  String    @unique
  reason     String?   @db.Text
  addedBy    String?
  expiresAt  DateTime?

  @@index([ipAddress])
  @@index([status, expiresAt])
  @@map("ip_white_lists")
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  name         String?
  createTime   DateTime @default(now())
  updateTime   DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("passkey_credentials")
}

model TwoFactorCredential {
  id                 String    @id @default(cuid())
  userId             String    @unique
  secret             String    @db.Text
  recoveryCodeHashes Json
  lastUsedAt         DateTime?
  createTime         DateTime  @default(now())
  updateTime         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_credentials")
}

model RelayChannel {
  id                          String   @id @default(cuid())
  status                      Int      @default(1)
  createTime                  DateTime @default(now())
  updateTime                  DateTime @updatedAt
  name                        String
  channelType                 String   @default("standalone") @db.VarChar(30)
  routingStrategy             String   @default("priority") @db.VarChar(30)
  routingConfig               Json?
  visibilityMode              String   @default("public") @db.VarChar(30)
  visibilityConfig            Json?
  openaiUpstreamUrl           String?  @db.Text
  openaiUpstreamApiKey        String?  @db.Text
  anthropicUpstreamUrl        String?  @db.Text
  anthropicUpstreamApiKey     String?  @db.Text
  geminiUpstreamUrl           String?  @db.Text
  geminiUpstreamApiKey        String?  @db.Text
  multiplier                  Decimal  @default(1.0) @db.Decimal(10, 6)
  allowedFormats              String   @default("all") @db.VarChar(50)
  allowedModels               String?  @db.Text
  addUserIdentifier           Boolean  @default(true)
  inputTokensIncludeCacheRead Boolean  @default(false)
  modelMapping                Json?
  timePeriodMultipliers       Json?    @default("[]")

  relayTokens          RelayToken[]              @relation("RelayTokenPrimaryChannel")
  automaticRouteTokens RelayToken[]              @relation("RelayTokenAutomaticProxyPool")
  tokenConfigs         RelayTokenChannelConfig[]
  poolMembers          RelayChannelMember[]      @relation("RelayChannelPool")
  memberOfPools        RelayChannelMember[]      @relation("RelayChannelPoolMember")
  fromSwitchLogs       RelayChannelSwitchLog[]   @relation("RelaySwitchLogFromChannel")
  toSwitchLogs         RelayChannelSwitchLog[]   @relation("RelaySwitchLogToChannel")
  ojApiKeys            OJAPIKey[]

  @@index([status])
  @@map("relay_channels")
}

model RelayChannelMember {
  id              String   @id @default(cuid())
  relayChannelId  String
  memberChannelId String
  priority        Int
