  startAt          DateTime
  endAt            DateTime
  totalQuota       Decimal  @db.Decimal(10, 4)
  dailyQuota       Decimal? @db.Decimal(10, 4)
  quotaUnit        String   @default("amount") @db.VarChar(20)
  quotaWindowHours Int?
  usedQuota        Decimal  @default(0) @db.Decimal(10, 4)
  remainingQuota   Decimal  @db.Decimal(10, 4)
  assignedBy       String?
  note             String?  @db.Text

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     MonthlyPassTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  usages       MonthlyPassUsage[]
  quotaWindows UserMonthlyPassQuotaWindow[]

  @@index([userId])
  @@index([templateId])
  @@index([status, startAt, endAt])
  @@index([userId, status, endAt])
  @@index([userId, status, remainingQuota, startAt, endAt])
  @@map("user_monthly_passes")
}

model UserMonthlyPassQuotaWindow {
  id                String   @id @default(cuid())
  userMonthlyPassId String
  quotaLimit        Decimal  @db.Decimal(10, 4)
  quotaUnit         String   @db.VarChar(20)
  quotaWindowHours  Decimal  @db.Decimal(10, 4)
  createTime        DateTime @default(now())
  updateTime        DateTime @updatedAt

  userMonthlyPass UserMonthlyPass @relation(fields: [userMonthlyPassId], references: [id], onDelete: Cascade)

  @@unique([userMonthlyPassId, quotaUnit, quotaWindowHours])
  @@index([userMonthlyPassId, quotaWindowHours])
  @@map("user_monthly_pass_quota_windows")
}

model MonthlyPassUsage {
  id                   String   @id @default(cuid())
  status               Int      @default(1)
  createTime           DateTime @default(now())
  updateTime           DateTime @updatedAt
  userMonthlyPassId    String
  userId               String
  relayUsageId         String?
  model                String?
  channelId            String?
  channelName          String?  @db.Text
  displayChannelId     String?
  displayChannelName   String?  @db.Text
  coveredAmount        Decimal  @db.Decimal(10, 4)
  coveredRequests      Int      @default(0)
  coveredTokens        Int      @default(0)
  totalRequestCost     Decimal  @db.Decimal(10, 4)
  remainingRequestCost Decimal  @db.Decimal(10, 4)
  description          String?  @db.Text

  userMonthlyPass UserMonthlyPass @relation(fields: [userMonthlyPassId], references: [id], onDelete: Cascade)

  @@index([userMonthlyPassId])
  @@index([userId, createTime])
  @@index([relayUsageId])
  @@index([model])
  @@index([displayChannelId])
  @@index([userMonthlyPassId, status, createTime])
  @@map("monthly_pass_usages")
}

model ModelPricing {
  id                      String   @id @default(cuid())
  status                  Int      @default(1)
  createTime              DateTime @default(now())
  updateTime              DateTime @updatedAt
  model                   String   @unique
  pricingType             String   @default("token-based") @db.VarChar(20)
  inputPrice              Decimal  @db.Decimal(10, 2)
  outputPrice             Decimal  @db.Decimal(10, 2)
  fixedPrice              Decimal? @db.Decimal(10, 4)
  provider                String?
  cacheCreationMultiplier Decimal  @default(1.25) @db.Decimal(10, 2)
  cacheReadMultiplier     Decimal  @default(0.10) @db.Decimal(10, 2)
  supportedFormats        String   @default("all") @db.VarChar(20)

  @@index([model])
  @@map("model_pricing")
}

model RelayConfig {
  id                    String   @id @default(cuid())
  status                Int      @default(1)
  createTime            DateTime @default(now())
  updateTime            DateTime @updatedAt
  globalMultiplier      Decimal  @default(1.0) @db.Decimal(10, 6)
  maxConcurrency        Int      @default(5)
  queueTimeout          Int      @default(30000)
  upstreamStreamTimeout Int      @default(120000)
  enableQueue           Boolean  @default(true)
  uptimeStatusUrl       String?  @db.Text
  monitorNameMapping    Json? // 简化的监控项名称映射 { "2": "中国主线路", "3": "国际线路" }
  showOnlyConfigured    Boolean? // 是否仅展示已配置的监控项
  uptimeTransformRules  Json? // 保留用于向后兼容
  uptimeStaticData      Json?

  @@map("relay_configs")
}

model OJAPIKey {
