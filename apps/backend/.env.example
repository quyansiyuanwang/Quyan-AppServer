PORT=10001
NODE_ENV=development

# 可信反向代理跳数。默认值为1，适用于单个托管反向代理。
# 当服务直接暴露时，将此值设置为0；否则，对于更长的代理链，请设置实际跳数。
TRUST_PROXY_HOPS=1

# 多域名部署的根域名。生产环境必填；CORS 和中央登录白名单留空时会从此值生成精确 Origin。
ROOT_DOMAIN=qysyw.test

# 可选：显式指定运行时加载的 .env 文件路径。
# 生产环境通常由 PM2 在 ecosystem.config.cjs 中注入，无需手动填写。
# ENV_FILE_PATH=/home/service/Quyan-Backend/.env
ENV_FILE_PATH=

# CORS 白名单（逗号分隔）。留空时从 ROOT_DOMAIN 生成完整的精确 SPA Origin；覆盖时禁止通配符。
CORS_ALLOWED_ORIGINS=

# 中央登录仅允许将已认证用户返回这些精确 first-party origin。留空时从 ROOT_DOMAIN 生成。
CENTRAL_LOGIN_ALLOWED_ORIGINS=
CENTRAL_LOGIN_FLOW_TTL_SECONDS=600

# MySQL connection URL. Do not append connection_limit, pool_timeout, or
# connect_timeout: mysql2 does not support those Prisma-era URL parameters.
DATABASE_URL="mysql://root:123456@localhost:3306/QysywDB"
# 测试 worker 专用覆盖项：数据库名称必须包含 test；worker 会按并发编号派生临时库。
APPSERVER_TEST_DATABASE_URL="mysql://root:123456@localhost:3306/QysywDB_test"

JWT_ACCESS_SECRET=your_access_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=5
JWT_REFRESH_EXPIRES_IN=28800

# 认证会话 Cookie（HttpOnly）配置
# - 用于服务端签发 sessionId，并在强制下线后按 Cookie 会话维度阻断访问/刷新
# - AUTH_SESSION_FORCE_OFFLINE_TTL_DAYS: 会话被强制下线后，在 Redis 中保持阻断状态的天数
AUTH_SESSION_COOKIE_NAME=auth_session_id
AUTH_SESSION_COOKIE_SAMESITE=strict
AUTH_SESSION_COOKIE_DOMAIN=
AUTH_SESSION_FORCE_OFFLINE_TTL_DAYS=30

# 刷新令牌 Cookie（HttpOnly）配置
# - 留空则使用默认值 refresh_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SAMESITE=strict
AUTH_REFRESH_COOKIE_DOMAIN=

# 防重放签名主密钥
# 要求：至少 64 字符，且必须与 JWT_ACCESS_SECRET / JWT_REFRESH_SECRET /
# TWO_FACTOR_TRUSTED_DEVICE_SECRET 分离；不同环境请使用不同密钥。
REPLAY_SIGNING_MASTER_SECRET=your_replay_signing_master_secret_with_at_least_sixty_four_characters_2026
# 防重放签名会话有效期（秒）
REPLAY_SIGNING_SESSION_TTL_SECONDS=600

# reCAPTCHA v3 配置
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=xxx
RECAPTCHA_MIN_SCORE=0.5

# 人机验证信任窗口配置
# - CAPTCHA_TRUST_WINDOW_MINUTES: 浏览器完成一次人机验证后，可在窗口期内跳过重复验证
# - CAPTCHA_TRUST_COOKIE_NAME: 信任 Cookie 名称
# - CAPTCHA_TRUST_COOKIE_SAMESITE: strict|lax|none
# - CAPTCHA_TRUST_COOKIE_DOMAIN: 留空表示不显式指定域名
# - CAPTCHA_TRUST_COOKIE_SECRET: 可选；留空则回退使用 REPLAY_SIGNING_MASTER_SECRET
CAPTCHA_TRUST_WINDOW_MINUTES=30
CAPTCHA_TRUST_COOKIE_NAME=captcha_trust
CAPTCHA_TRUST_COOKIE_SAMESITE=lax
CAPTCHA_TRUST_COOKIE_DOMAIN=
CAPTCHA_TRUST_COOKIE_SECRET=

# Cloudflare Turnstile 配置
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# 频率限制配置（收紧后的默认值）
RATE_LIMIT_LOGIN_IP_MAX=10
RATE_LIMIT_LOGIN_IP_WINDOW=1
RATE_LIMIT_LOGIN_USER_MAX=5
RATE_LIMIT_LOGIN_USER_WINDOW=1
RATE_LIMIT_IP_MAX=5
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_IP_EMAIL_MAX=2
RATE_LIMIT_IP_EMAIL_WINDOW=60

# 通用请求体大小限制（MB）
# - REQUEST_JSON_BODY_LIMIT_MB: express.json 和 JSON 请求守卫上限
# - REQUEST_URLENCODED_BODY_LIMIT_MB: express.urlencoded 上限
# - REQUEST_OTHER_BODY_LIMIT_MB: 非 JSON / multipart 请求守卫兜底上限
REQUEST_JSON_BODY_LIMIT_MB=5
REQUEST_URLENCODED_BODY_LIMIT_MB=10
REQUEST_OTHER_BODY_LIMIT_MB=10

# 2FA 验证提交频率限制
RATE_LIMIT_2FA_IP_MAX=20
RATE_LIMIT_2FA_IP_WINDOW=10
RATE_LIMIT_2FA_CHALLENGE_MAX=5
RATE_LIMIT_2FA_CHALLENGE_WINDOW=10

# 2FA 邮箱验证码发送频率限制（独立于验证提交次数）
RATE_LIMIT_2FA_EMAIL_SEND_IP_MAX=10
RATE_LIMIT_2FA_EMAIL_SEND_IP_WINDOW=10
RATE_LIMIT_2FA_EMAIL_SEND_CHALLENGE_MAX=3
RATE_LIMIT_2FA_EMAIL_SEND_CHALLENGE_WINDOW=10

# 2FA 可信设备列表/删除操作频率限制（防枚举）
RATE_LIMIT_2FA_TRUSTED_DEVICE_IP_MAX=60
RATE_LIMIT_2FA_TRUSTED_DEVICE_IP_WINDOW=10
RATE_LIMIT_2FA_TRUSTED_DEVICE_USER_MAX=30
RATE_LIMIT_2FA_TRUSTED_DEVICE_USER_WINDOW=10

RATE_LIMIT_RETENTION_DAYS=7

# 2FA 可信窗口（分钟），在此窗口内同一设备登录可跳过二次验证
TWO_FACTOR_TRUST_WINDOW_MINUTES=1440
# 2FA 可信设备 Cookie 签名密钥
# 要求：至少 64 字符，且必须与 JWT_ACCESS_SECRET 分离
# 多环境：development/test/production 必须使用不同密钥，避免跨环境 Cookie 互信
# 轮换：替换后重启服务；旧 Cookie 将在窗口期自然失效，紧急情况下可清理 Redis two_factor:trusted:* 键
TWO_FACTOR_TRUSTED_DEVICE_SECRET=your_trusted_device_secret_key_with_at_least_sixty_four_characters_2026
# 2FA 可信设备 Cookie SameSite 策略（strict|lax|none）
# - strict: 安全性最高，跨站导航不会携带 Cookie
# - lax: 兼容部分跨站跳转场景
# - none: 需配合 HTTPS（浏览器要求 Secure）
TWO_FACTOR_TRUSTED_DEVICE_COOKIE_SAMESITE=strict
# 2FA 可信设备 Cookie Domain，留空表示不显式指定
# 示例：.${ROOT_DOMAIN}（仅在确实需要跨子域共享可信设备 Cookie 时设置）
TWO_FACTOR_TRUSTED_DEVICE_COOKIE_DOMAIN=

# 2FA TOTP 配置
TWO_FACTOR_TOTP_INTERVAL_SECONDS=30
TWO_FACTOR_TOTP_WINDOW_STEPS=1

# 2FA 恢复码配置
TWO_FACTOR_RECOVERY_CODE_COUNT=10

# 2FA 登录提醒配置（未开启 2FA 的账号）
TWO_FACTOR_REMINDER_ENABLED=true
TWO_FACTOR_REMINDER_INTERVAL_DAYS=7

# 远程终端（Remote Terminal）
# 远程终端安装 Token 签名密钥
RTM_INSTALL_TOKEN_SECRET=your_rtm_install_token_secret_with_at_least_sixty_four_characters_here_2026

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 测试 worker 的 Redis 起始逻辑库；实际 worker 会基于 TEST_REDIS_DB_BASE 计算覆盖值。
APPSERVER_TEST_REDIS_DB=8
# Redis 断路器配置（连续失败达到阈值后短时打开断路器）
REDIS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_BREAKER_OPEN_MS=30000

# Anthropic AI 兜底配置 (OJSubmitter) - 优先使用 Relay Settings 中的 Anthropic 上游配置
ANTHROPIC_API_KEY=
# Anthropic API 地址（默认 https://api.anthropic.com）
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 开发者产品密钥托管主密钥
# 要求：至少 64 字符，且必须与 JWT / 防重放 / 2FA 密钥不同。
DEVELOPER_SECRETS_MASTER_KEY=your_developer_secrets_master_key_with_at_least_sixty_four_characters_2026
# Dedicated AES-256-GCM master key for encrypted Relay channel probe credentials. Must be >=64 characters and unique.
RELAY_CHANNEL_PROBE_MASTER_KEY=your_relay_channel_probe_master_key_with_at_least_sixty_four_characters_2026
# Dedicated AES-256-GCM master key for encrypted Relay channel change-request credentials. Must be >=64 characters and unique.
RELAY_CHANNEL_CHANGE_REQUEST_MASTER_KEY=your_relay_channel_change_request_master_key_with_at_least_sixty_four_characters_2026
# IP 定位产品的通用 HTTP(S) 供应商端点；留空时会自动使用 BAIDU_IP_LOCATION_AK 的百度 IP 定位适配器。
IP_GEOLOCATION_ENDPOINT=

# 分布式锁配置
# - acquireTimeoutMs: 获取锁最长等待时间
# - retryIntervalMs: 获取锁失败后的重试间隔
# - defaultTtlMs: 锁默认 TTL
# - failClosed: 获取锁失败时是否默认拒绝敏感操作
DISTRIBUTED_LOCK_ACQUIRE_TIMEOUT_MS=5000
DISTRIBUTED_LOCK_RETRY_INTERVAL_MS=100
DISTRIBUTED_LOCK_DEFAULT_TTL_MS=10000
DISTRIBUTED_LOCK_FAIL_CLOSED=true

# 归档 OSS（五项均配置后才启用；可使用 Archive/冷归档 bucket）
ARCHIVE_OSS_ENDPOINT=
ARCHIVE_OSS_REGION=
ARCHIVE_OSS_BUCKET=
ARCHIVE_OSS_ACCESS_KEY_ID=
ARCHIVE_OSS_ACCESS_KEY_SECRET=
ARCHIVE_OSS_PREFIX=appserver-archives

# 导入暂存 OSS（五项均配置后才允许归档导入；必须使用可立即读取的 Standard bucket）
STAGING_OSS_ENDPOINT=
STAGING_OSS_REGION=
STAGING_OSS_BUCKET=
STAGING_OSS_ACCESS_KEY_ID=
STAGING_OSS_ACCESS_KEY_SECRET=
STAGING_OSS_PREFIX=appserver-staging

# WebAuthn / Passkey 配置
WEBAUTHN_RP_NAME=AppServer
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# 外部 OAuth 登录回调使用的前端地址（默认 http://localhost:5173）
# 社会登录回调页面的唯一前端 origin；生产环境通常使用 https://auth.${ROOT_DOMAIN}。
FRONTEND_BASE_URL=http://localhost:5173
# 外部登录状态与二维码登录时效（秒）
EXTERNAL_AUTH_STATE_TTL_SECONDS=600
QR_LOGIN_TTL_SECONDS=300
QR_LOGIN_POLL_INTERVAL_SECONDS=2

# GitHub OAuth（启用后填写 Client ID/Secret；回调路径为后端路径）
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_USER_URL=https://api.github.com/user
GITHUB_OAUTH_EMAIL_URL=https://api.github.com/user/emails
GITHUB_OAUTH_SCOPE=read:user user:email
GITHUB_OAUTH_CALLBACK_PATH=/v1/auth/external/github/callback

# 微信开放平台扫码 OAuth（面向 PC）
WECHAT_OPEN_OAUTH_ENABLED=false
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_AUTHORIZE_URL=https://open.weixin.qq.com/connect/qrconnect
WECHAT_OPEN_TOKEN_URL=https://api.weixin.qq.com/sns/oauth2/access_token
WECHAT_OPEN_USER_URL=https://api.weixin.qq.com/sns/userinfo
WECHAT_OPEN_SCOPE=snsapi_login
WECHAT_OPEN_CALLBACK_PATH=/v1/auth/external/wechat-open/callback

# 微信网页 OAuth（面向微信内网页）
WECHAT_WEB_OAUTH_ENABLED=false
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_AUTHORIZE_URL=https://open.weixin.qq.com/connect/oauth2/authorize
WECHAT_WEB_TOKEN_URL=https://api.weixin.qq.com/sns/oauth2/access_token
WECHAT_WEB_USER_URL=https://api.weixin.qq.com/sns/userinfo
WECHAT_WEB_SCOPE=snsapi_userinfo
WECHAT_WEB_CALLBACK_PATH=/v1/auth/external/wechat-web/callback

# Auth Center（OIDC）签名配置
# - 开发环境留空时会自动生成临时 RSA 密钥对
# - 生产环境必须显式提供 AUTH_CENTER_JWT_PRIVATE_KEY / AUTH_CENTER_JWT_PUBLIC_KEY
# - 多行 PEM 可直接粘贴，或使用 \n 转义换行
AUTH_CENTER_ISSUER=http://localhost:10001/auth-center
AUTH_CENTER_JWT_PRIVATE_KEY=
AUTH_CENTER_JWT_PUBLIC_KEY=
AUTH_CENTER_JWT_KID=

# 受保护的用户组（不允许删除）
PROTECTED_GROUP_NAME=admin

# 超级管理员用户组标识（可授予任意合法权限）
SUPER_ADMIN_GROUP_USERNAME=admin

# 月卡分页 / 配额窗口上限
# - MONTHLY_PASS_DEFAULT_PAGE_SIZE: 月卡列表默认分页大小
# - MONTHLY_PASS_DEFAULT_QUOTA_WINDOW_HOURS: 默认配额滑动窗口（小时）
# - MONTHLY_PASS_MAX_QUOTA_WINDOW_HOURS: 最大允许配额滑动窗口（小时）
# - MONTHLY_PASS_MAX_AMOUNT_QUOTA: 金额配额字段最大值
# - MONTHLY_PASS_MAX_INTEGER_QUOTA: 整数配额字段最大值
MONTHLY_PASS_DEFAULT_PAGE_SIZE=20
MONTHLY_PASS_DEFAULT_QUOTA_WINDOW_HOURS=24
MONTHLY_PASS_MAX_QUOTA_WINDOW_HOURS=720
MONTHLY_PASS_MAX_AMOUNT_QUOTA=999999.9999
MONTHLY_PASS_MAX_INTEGER_QUOTA=999999

# logging 配置
DISABLE_CONSOLE_LOG=false
ENABLE_FILE_LOGGING=true

# ============================================================================
# Relay 资源保护配置 (Resource Guard)
# ============================================================================
# 这些配置用于防止低配服务器在处理大图片请求时卡死或 OOM
# 图片请求（如 images/generations、images/edits、以及携带 image_generation 工具的 /responses）
# 会进入独立的 image 并发作用域，并使用更严格的限制

# 图片请求最大并发数 (1-10)
# - 限制同时处理的图片请求数量，防止 CPU 过载
# - 图片请求的有效上限 = min(maxConcurrency, imageMaxConcurrency)
# - 文本/普通请求使用独立的 default 并发作用域，不会占用图片并发槽位
# 推荐值:
#   2v2g (2核2GB): 1 - 防止服务器卡死
#   2v4g (2核4GB): 2 - 平衡性能和稳定性
#   2v8g (2核8GB): 3 - 充分利用内存
#   4v4g (4核4GB): 4 - CPU 充足可提高并发
#   4v8g (4核8GB): 6 - 高性能配置
RELAY_IMAGE_MAX_CONCURRENCY=1

# 图片请求队列超时时间（毫秒，0-300000）
# - 图片请求在 image 作用域队列中等待的最大时间
# - 超时后返回 429 Too Many Requests
# - 默认 30 秒，生产环境建议 300000 (5分钟)
RELAY_IMAGE_QUEUE_TIMEOUT_MS=300000

# Multipart 请求体大小限制（MB，1-20）
# - 限制 images/edits 等 form-data 上传的最大大小
# - 过大会导致内存占用过高，过小会拒绝合理的图片
# 推荐值:
#   2v2g: 4MB  - 保守配置
#   2v4g: 8MB  - 平衡配置
#   2v8g: 20MB - 支持大图片
RELAY_MULTIPART_BODY_LIMIT_MB=6

# 非流式请求上游超时时间（毫秒，10000-600000）
# - 等待上游 API 响应的最大时间
# - 图片生成通常需要 10-60 秒
# - 默认 600000 (10分钟)
RELAY_NON_STREAM_UPSTREAM_TIMEOUT_MS=600000

# 上游响应体最大大小（MB，1-128）
# - 限制从上游 API 接收的响应体大小（text/chat 接口）
# - 防止恶意或异常的大响应耗尽内存
# 推荐值:
#   2v2g: 32MB  - 保守配置
#   2v4g: 64MB  - 标准配置
#   2v8g: 128MB - 宽松配置
RELAY_MAX_UPSTREAM_RESPONSE_BODY_MB=48

# 图片接口响应体最大大小（MB，1-64）
# - 单独限制图片生成相关接口（如 images/generations、images/edits、/responses + image_generation）的响应大小
# - 图片接口会返回 URL 或 base64，base64 大图可能很大
# - 超过限制时 axios 抛错，返回 502 而不是内存爆炸
# 推荐值:
#   2v2g: 16MB  - 防止单张大图击穿内存（URL 模式几乎不占内存）
#   2v4g: 32MB  - 允许中等质量 base64 图片
#   2v8g: 48MB  - 宽松配置
RELAY_IMAGE_RESPONSE_BODY_LIMIT_MB=16

# ====== 第三方 API 配置示例 ======

# 用于在线状态监控和 IP 定位产品的百度 IP 归属地，申请地址：https://lbsyun.baidu.com/
BAIDU_IP_LOCATION_AK=your_baidu_ip_location_ak_here
