PORT=10002
NODE_ENV=test

# 测试数据库配置 - 使用独立的测试数据库
DATABASE_URL="mysql://root:123456@localhost:3306/QysywDB_test"
PROTECTED_GROUP_NAME=__test_protected_group__

JWT_ACCESS_SECRET=test_access_secret_key
JWT_REFRESH_SECRET=test_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=5
JWT_REFRESH_EXPIRES_IN=28800
REPLAY_SIGNING_MASTER_SECRET=test_replay_signing_master_secret_with_at_least_sixty_four_characters_2026
REPLAY_SIGNING_SESSION_TTL_SECONDS=600

# 2FA trusted-device token signing secret (>=64 chars for tests)
TWO_FACTOR_TRUSTED_DEVICE_SECRET=test_trusted_device_secret_key_with_at_least_sixty_four_characters_2026

# Disable reCAPTCHA for tests
RECAPTCHA_ENABLED=false

# 通用请求体大小限制（MB）
REQUEST_JSON_BODY_LIMIT_MB=5
REQUEST_URLENCODED_BODY_LIMIT_MB=2
REQUEST_OTHER_BODY_LIMIT_MB=10

# Relay 资源保护配置 - 测试环境使用宽松配置
RELAY_MULTIPART_BODY_LIMIT_MB=20
RELAY_IMAGE_MAX_CONCURRENCY=5
RELAY_IMAGE_QUEUE_TIMEOUT_MS=60000
RELAY_NON_STREAM_UPSTREAM_TIMEOUT_MS=600000
RELAY_MAX_UPSTREAM_RESPONSE_BODY_MB=128

# 开发者产品密钥托管主密钥
# 要求：至少 64 字符，且必须与 JWT / 防重放 / 2FA 密钥不同。
DEVELOPER_SECRETS_MASTER_KEY=your_developer_secrets_master_key_with_at_least_sixty_four_characters_2026
# IP 定位产品的通用 HTTP(S) 供应商端点；留空时会自动使用 BAIDU_IP_LOCATION_AK 的百度 IP 定位适配器。
IP_GEOLOCATION_ENDPOINT=
