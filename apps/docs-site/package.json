{
  "name": "@appserver/docs-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "--- a_dev ---------------------------": "",
    "dev": "pnpm run support:knowledge:generate && vite",
    "production": "pnpm run support:knowledge:generate && vite --mode production",
    "preview": "vite preview",
    "--- b_build_atomic ----------------": "",
    "support:knowledge:generate": "node ./scripts/generate-support-knowledge.mjs",
    "compile": "pnpm run support:knowledge:generate && vite build",
    "compile:production": "pnpm run support:knowledge:generate && vite build --mode production",
    "--- c_build_meta ------------------": "",
    "build:only": "pnpm run compile",
    "build:only:production": "pnpm run compile:production",
    "build": "concurrently --kill-others-on-fail --names types,compile \"pnpm run type-check\" \"pnpm run build:only\"",
    "build:production": "concurrently --kill-others-on-fail --names types,compile \"pnpm run type-check\" \"pnpm run build:only:production\"",
    "--- d_typecheck -------------------": "",
    "type-check": "vue-tsc --build",
    "--- e_lint_format -----------------": "",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint-format-check": "pnpm run lint:check && pnpm run format:check && pnpm run type-check",
    "spell:check": "cspell lint \"src/**/*.{ts,js,vue}\"",
    "--- f_check -----------------------": "",
    "check": "pnpm run lint-format-check",
    "precommit": "pnpm run lint && pnpm run format && pnpm run type-check"
  },
  "dependencies": {
    "marked": "^17.0.0",
    "mermaid": "^11.15.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vue-tsc": "^3.1.1"
  }
}
