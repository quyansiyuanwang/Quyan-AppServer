# Static frontend site example. Replace the hostname and dist path per site.
server {
  listen 80;
  server_name console.example.com;
  root /srv/appserver/frontend/dist;
  index index.html;

  client_max_body_size 20M;

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # Independent recovery entry must never fall back to the normal application.
  location = /repair.html {
    try_files $uri =404;
    add_header Cache-Control "no-store";
  }

  location = /404.html {
    add_header Cache-Control "no-cache";
  }

  # Let Vue Router handle deep links; API traffic belongs on api.example.com.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }

  # Only content-hashed assets are immutable. Missing chunks must not return HTML.
  location ^~ /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
}
